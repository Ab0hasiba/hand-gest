    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "true_labels = []\n",
    "predictions = []\n",
    "images = []\n",
    "\n",
    "for batch_images, batch_labels in test_ds:\n",
    "    batch_predictions = model.predict(batch_images, verbose=0)\n",
    "    batch_predictions = np.argmax(batch_predictions, axis=1)\n",
    "\n",
    "    images.extend(batch_images.numpy())\n",
    "    true_labels.extend(batch_labels.numpy())\n",
    "    predictions.extend(batch_predictions)\n",
    "\n",
    "true_labels = np.array(true_labels)\n",
    "predictions = np.array(predictions)\n",
    "images = np.array(images)\n",
    "\n",
    "wrong_indices = np.where(\n",
    "    (true_labels == 2) & (predictions == 3)\n",
    ")[0]\n",
    "\n",
    "print(\"Wrong 03_fist predictions:\", len(wrong_indices))\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "\n",
    "for i, idx in enumerate(wrong_indices[:16]):\n",
    "    plt.subplot(4, 4, i + 1)\n",
    "    plt.imshow(images[idx].squeeze(), cmap=\"gray\")\n",
    "    plt.title(\"True: 03_fist\\nPred: 04_fist_moved\")\n",
    "    plt.axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
