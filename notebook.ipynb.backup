    "train_true_labels = []\n",
    "train_predictions = []\n",
    "\n",
    "for batch_images, batch_labels in train_ds:\n",
    "    batch_predictions = model.predict(batch_images, verbose=0)\n",
    "    batch_predictions = np.argmax(batch_predictions, axis=1)\n",
    "\n",
    "    train_true_labels.extend(batch_labels.numpy())\n",
    "    train_predictions.extend(batch_predictions)\n",
    "\n",
    "train_true_labels = np.array(train_true_labels)\n",
    "train_predictions = np.array(train_predictions)\n",
    "\n",
    "fist_mask = train_true_labels == 2\n",
    "\n",
    "fist_correct = np.sum(\n",
    "    train_predictions[fist_mask] == 2\n",
    ")\n",
    "\n",
    "fist_total = np.sum(fist_mask)\n",
    "\n",
    "print(\"03_fist training accuracy:\", fist_correct / fist_total)\n",
    "print(\"03_fist correct:\", fist_correct)\n",
    "print(\"03_fist total:\", fist_total)"
   ]
  },
