   "source": [
    "from collections import defaultdict\n",
    "\n",
    "# Find misclassified examples for each actual class\n",
    "errors = defaultdict(list)\n",
    "\n",
    "for i, (true, pred) in enumerate(zip(y_true, y_pred)):\n",
    "    if true != pred:\n",
    "        errors[true].append((i, pred))\n",
    "\n",
    "print(\"Misclassifications by true class:\\n\")\n",
    "\n",
    "for true_class, examples in errors.items():\n",
    "    print(\n",
    "        f\"{classes[true_class]}: \"\n",
    "        f\"{len(examples)} errors\"\n",
    "    )\n",
    "\n",
    "    # Show where they were predicted\n",
    "    counts = Counter(pred for _, pred in examples)\n",
    "\n",
    "    for pred_class, count in counts.most_common():\n",
    "        print(f\"    → {classes[pred_class]}: {count}\")\n",
    "\n",
    "    print()"
   ]
  },
