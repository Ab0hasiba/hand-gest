   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "class_names = [\n",
    "    \"01_palm\",\n",
    "    \"02_l\",\n",
    "    \"03_fist\",\n",
    "    \"04_fist_moved\",\n",
    "    \"05_thumb\",\n",
    "    \"06_index\",\n",
    "    \"07_ok\",\n",
    "    \"08_palm_moved\",\n",
    "    \"09_c\",\n",
    "    \"10_down\"\n",
    "]\n",
    "\n",
    "true_labels = []\n",
    "predictions = []\n",
    "images = []\n",
    "\n",
    "for batch_images, batch_labels in test_ds:\n",
    "    batch_predictions = model.predict(batch_images, verbose=0)\n",
    "    batch_predictions = np.argmax(batch_predictions, axis=1)\n",
    "\n",
    "    images.extend(batch_images.numpy())\n",
    "    true_labels.extend(batch_labels.numpy())\n",
    "    predictions.extend(batch_predictions)\n",
    "\n",
    "images = np.array(images)\n",
    "true_labels = np.array(true_labels)\n",
    "predictions = np.array(predictions)\n",
    "\n",
    "print(\"Images:\", images.shape)\n",
    "print(\"Labels:\", true_labels.shape)\n",
    "print(\"Predictions:\", predictions.shape)\n",
    "\n",
    "for class_id in [2, 3]:\n",
    "    class_images = images[true_labels == class_id]\n",
    "\n",
    "    print(\"\\nClass:\", class_names[class_id])\n",
    "    print(\"Number of images:\", len(class_images))\n",
    "    print(\"Mean pixel value:\", class_images.mean())\n",
    "    print(\"Standard deviation:\", class_images.std())\n",
    "    print(\"Minimum pixel value:\", class_images.min())\n",
    "    print(\"Maximum pixel value:\", class_images.max())"
   ]
  },
