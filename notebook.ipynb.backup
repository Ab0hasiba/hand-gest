   "source": [
    "import os\n",
    "\n",
    "total_images = 0\n",
    "\n",
    "for root, dirs, files in os.walk(dataset_path):\n",
    "    images = [\n",
    "        f for f in files\n",
    "        if f.lower().endswith((\".png\", \".jpg\", \".jpeg\"))\n",
    "    ]\n",
    "    total_images += len(images)\n",
    "\n",
    "print(\"Total images:\", total_images)"
   ]
