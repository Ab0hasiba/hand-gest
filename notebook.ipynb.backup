    "for i, (images, labels) in enumerate(test_ds.take(1)):\n",
    "    predictions = model.predict(images, verbose=0)\n",
    "    predicted_labels = np.argmax(predictions, axis=1)\n",
    "\n",
    "    for j in range(12):\n",
    "        plt.subplot(3, 4, j + 1)\n",
    "\n",
    "        plt.imshow(images[j].numpy().squeeze(), cmap=\"gray\")\n",
    "\n",
    "        true_class = classes[labels[j].numpy()]\n",
    "        pred_class = classes[predicted_labels[j]]\n",
    "\n",
    "        plt.title(\n",
    "            f\"True: {true_class}\\nPred: {pred_class}\",\n",
    "            fontsize=9\n",
    "        )\n",
    "\n",
    "        plt.axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
