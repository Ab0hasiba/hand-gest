    "def evaluate_subject_fist(df, subject):\n",
    "    subject_df = df[df[\"subject\"] == subject]\n",
    "\n",
    "    images = []\n",
    "    labels = []\n",
    "\n",
    "    for _, row in subject_df.iterrows():\n",
    "        image = tf.io.read_file(row[\"path\"])\n",
    "        image = tf.image.decode_png(image, channels=1)\n",
    "        image = tf.image.resize(image, IMG_SIZE)\n",
    "        image = tf.cast(image, tf.float32) / 255.0\n",
    "\n",
    "        images.append(image)\n",
    "        labels.append(row[\"label\"])\n",
    "\n",
    "    images = tf.stack(images)\n",
    "    labels = np.array(labels)\n",
    "\n",
    "    predictions = model.predict(images, verbose=0)\n",
    "    predictions = np.argmax(predictions, axis=1)\n",
    "\n",
    "    fist_mask = labels == 2\n",
    "\n",
    "    correct = np.sum(predictions[fist_mask] == 2)\n",
    "    total = np.sum(fist_mask)\n",
    "\n",
    "    print(f\"Subject {subject}\")\n",
    "    print(\"03_fist correct:\", correct)\n",
    "    print(\"03_fist total:\", total)\n",
    "    print(\"03_fist accuracy:\", correct / total)\n",
    "    print()\n",
    "evaluate_subject_fist(val_df, \"07\")\n",
    "evaluate_subject_fist(val_df, \"08\")\n",
    "evaluate_subject_fist(test_df, \"09\")"
   ]
  },
