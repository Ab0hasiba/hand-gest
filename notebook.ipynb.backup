   "source": [
    "import matplotlib.pyplot as plt\n",
    "import cv2\n",
    "import random\n",
    "\n",
    "image_paths = list(dataset_path.rglob(\"*.png\"))\n",
    "\n",
    "samples = random.sample(image_paths, 12)\n",
    "\n",
    "plt.figure(figsize=(15, 10))\n",
    "\n",
    "for i, image_path in enumerate(samples):\n",
    "    image = cv2.imread(str(image_path), cv2.IMREAD_GRAYSCALE)\n",
    "\n",
    "    plt.subplot(3, 4, i + 1)\n",
    "    plt.imshow(image, cmap=\"gray\")\n",
    "    plt.title(image_path.parent.name)\n",
    "    plt.axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
