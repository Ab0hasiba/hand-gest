   "source": [
    "from pathlib import Path\n",
    "\n",
    "# Find directories that contain the subject folders 00-09\n",
    "candidates = []\n",
    "\n",
    "for folder in dataset_path.rglob(\"*\"):\n",
    "    if folder.is_dir():\n",
    "        subjects = {\n",
    "            p.name for p in folder.iterdir()\n",
    "            if p.is_dir()\n",
    "        }\n",
    "\n",
    "        if set(f\"{i:02d}\" for i in range(10)).issubset(subjects):\n",
    "            candidates.append(folder)\n",
    "\n",
    "for folder in candidates:\n",
    "    print(folder)"
   ]
  },
